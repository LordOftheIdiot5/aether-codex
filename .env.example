# Copy this file to .env and fill in what you need.

# Default LLM provider for the Director and all agents: anthropic | grok | local
AETHER_PROVIDER=anthropic

# Optional model override. Leave empty for the provider default
# (anthropic -> claude-sonnet-5, grok -> grok-4, local -> llama3.1)
AETHER_MODEL=

# Sampling temperature (used by grok/local; Claude models ignore it)
AETHER_TEMPERATURE=0.4

# Provider credentials — only the one you use is required
ANTHROPIC_API_KEY=
XAI_API_KEY=

# Local models (only used when AETHER_PROVIDER=local)
OLLAMA_BASE_URL=http://localhost:11434

# Block-explorer key for reading deployed contracts on-chain
# (fetch_contract_source / rug-screening). Free key, one works across all
# supported chains: https://etherscan.io/apis
ETHERSCAN_API_KEY=
