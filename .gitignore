.env
.venv/
__pycache__/
*.pyc

# Foundry dependency — re-install with:  forge install foundry-rs/forge-std
# (or: git clone --depth 1 https://github.com/foundry-rs/forge-std lib/forge-std)
lib/

# Runtime data is transient EXCEPT the invariant library, which is the rig's
# compounding knowledge base and worth versioning / backing up to GitHub.
data/*
!data/invariant_library.json

reports/*
!reports/.gitkeep
audit_target/*
!audit_target/.gitkeep

# Fork lab: keep the learning PoCs + config, ignore build artifacts
fork_lab/out/
fork_lab/cache/

# PoC workspace: keep the project config, ignore agent-generated code + build
poc_workspace/out/
poc_workspace/cache/
poc_workspace/broadcast/
poc_workspace/src/*
!poc_workspace/src/.gitkeep
poc_workspace/test/*
!poc_workspace/test/.gitkeep
